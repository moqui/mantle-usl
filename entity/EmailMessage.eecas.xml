<!-- The framework's mail client messages on Mantle's records (mantle.party.CommunicationServices.handle#EmailMessageFiling):
    a received message stored in an account runs file#ReceivedEmail (filing by the account's policy, the NewMail alert),
    and a message of an account that becomes sent runs file#SentEmail (the records send#EmailDraft kept for it, and the
    party match of an account that files every match). Both run after the commit of the write, in a transaction of their
    own, so they never fail or slow the store or the send. A deleted message's kept records go. -->
<eecas xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/entity-eca-3.xsd">
    <eeca id="EmailMessageFiling" entity="moqui.basic.email.EmailMessage" on-create="true" on-update="true" on-delete="true"
            run-on-error="false" get-entire-entity="true" get-original-value="true">
        <condition><expression>eecaOperation == 'delete' || (emailAccountId != null &amp;&amp; emailAccountId != '' &amp;&amp;
            ((statusId == 'ES_SENT' &amp;&amp; (eecaOperation == 'create' || originalValue == null || originalValue.statusId != 'ES_SENT')) ||
            (eecaOperation == 'create' &amp;&amp; (statusId == 'ES_RECEIVED' || statusId == 'ES_VIEWED'))))</expression></condition>
        <actions><service-call name="mantle.party.CommunicationServices.handle#EmailMessageFiling" in-map="{eecaOperation:eecaOperation,
                emailMessageId:emailMessageId, emailAccountId:emailAccountId, statusId:statusId,
                oldStatusId:(originalValue == null ? null : originalValue.statusId)}"/></actions>
    </eeca>
</eecas>
