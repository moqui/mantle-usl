<secas xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/service-eca-3.xsd">
    <!-- On all Work Efforts auto set actualStartDate on WeInProgress and actualCompletionDate on WeComplete -->
    <seca id="WorkEffortStartCompleteDates" service="update#mantle.work.effort.WorkEffort" when="post-service">
        <condition><expression>statusChanged &amp;&amp; ['WeInProgress', 'WeComplete'].includes(statusId)</expression></condition>
        <actions>
            <entity-find-one entity-name="mantle.work.effort.WorkEffort" value-field="workEffort"/>
            <if condition="workEffort.actualStartDate == null &amp;&amp; statusId == 'WeInProgress'"><then>
                <set field="workEffort.actualStartDate" from="ec.user.nowTimestamp"/>
                <entity-update value-field="workEffort"/>
            </then><else-if condition="workEffort.actualCompletionDate == null &amp;&amp; statusId == 'WeComplete'">
                <set field="workEffort.actualCompletionDate" from="ec.user.nowTimestamp"/>
                <entity-update value-field="workEffort"/>
            </else-if></if>
        </actions>
    </seca>

    <!-- A recurring task completed, or cancelled to skip it, makes the next one (design-projects.md §5 "Recurring work items");
        a failure there is logged and leaves the status change as it is -->
    <seca id="WorkEffortRecurringTaskNext" service="update#mantle.work.effort.WorkEffort" when="post-service">
        <condition><expression>statusChanged &amp;&amp; ['WeComplete', 'WeCancelled'].includes(statusId)</expression></condition>
        <actions><service-call name="mantle.work.TaskServices.make#NextRecurringTask" in-map="{workEffortId:workEffortId}" ignore-error="true"/></actions>
    </seca>
    <!-- A party assigned to a task of a project: its users are told on the topic WorkItemAssigned -->
    <seca id="WorkEffortPartyAssignedNotify" service="create#mantle.work.effort.WorkEffortParty" when="post-service">
        <condition><expression>roleTypeId == 'Assignee' &amp;&amp; !['WeptDeclined', 'WeptUnassigned'].includes(statusId)</expression></condition>
        <actions><service-call name="mantle.work.TaskServices.notify#TaskAssigned" in-map="{workEffortId:workEffortId, partyId:partyId}"/></actions>
    </seca>

    <!-- Shipment Ship/Load Status Check - based on associated Shipment Status -->
    <seca id="WorkEffortShipLoadStatusCheck" service="update#mantle.work.effort.WorkEffort" when="pre-validate">
        <condition><expression>workEffortId &amp;&amp; ['WeComplete', 'WeClosed', 'WeCancelled'].includes(statusId)</expression></condition>
        <actions><service-call name="mantle.work.ShipmentWorkServices.check#ShipmentLoadStatusChange"
                in-map="{workEffortId:workEffortId, statusId:statusId}"/></actions>
    </seca>
    <!-- Shipment Ship/Load Auto Status based on associated Shipment Status -->
    <seca id="WorkEffortShipLoadStatusAuto" service="update#mantle.shipment.Shipment" when="post-service">
        <condition><expression>statusChanged &amp;&amp; (['ShipPicked', 'ShipPacked', 'ShipShipped', 'ShipCancelled'].includes(statusId) ||
            ['ShipPicked', 'ShipPacked', 'ShipShipped', 'ShipCancelled'].includes(oldStatusId))</expression></condition>
        <actions><service-call name="mantle.work.ShipmentWorkServices.set#ShipmentLoadStatusOnShipmentStatus"
                in-map="{shipmentId:shipmentId, statusId:statusId}"/></actions>
    </seca>
</secas>
