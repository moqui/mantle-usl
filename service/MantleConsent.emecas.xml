<emecas xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/email-eca-3.xsd">
    <!-- the List-Unsubscribe mailto of a list email: a received email whose subject is "unsubscribe <token>"
        (mantle.party.ConsentServices create#UnsubscribeToken with mailtoAddress, process#UnsubscribeEmail) -->
    <emeca rule-name="ListUnsubscribeMailto">
        <condition><expression>/^\s*unsubscribe\s+[A-Za-z0-9_-]{16,128}\s*$/i.test(String((fields &amp;&amp; fields.subject) || ''))</expression></condition>
        <actions>
            <service-call name="mantle.party.ConsentServices.process#UnsubscribeEmail" in-map="context"/>
        </actions>
    </emeca>
</emecas>
