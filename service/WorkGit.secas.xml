<!-- Merge requests and commit statuses on work items (MR Moqui, no Java counterpart; design-projects.md §7, §15 "Merge request
    links"): the gitECA-style rules beside Work.gitecas.xml, after the framework's Mantle-free review services. Every event a
    merge request queues for its webhooks (org.moqui.impl.GitReviewServices.queue#MergeRequestEvent: opened, updated, ready,
    reviewed, synchronize, closed, reopened, and merged by a push), a merge through Moqui (merge#MergeRequest, which queues
    its webhooks itself) and reviewers asked later (set#MergeRequestReviewers) run mantle.work.GitServices.handle#MergeRequestEvent;
    a failed or erred commit status tells its author (notify#CommitStatusFailed). Each logs its own failures. -->
<secas xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/service-eca-3.xsd">
    <seca id="GitMergeRequestEvent" service="org.moqui.impl.GitReviewServices.queue#MergeRequestEvent" when="post-service">
        <actions><service-call name="mantle.work.GitServices.handle#MergeRequestEvent" in-map="{mergeRequestId:mergeRequestId, action:action}" ignore-error="true"/></actions>
    </seca>
    <seca id="GitMergeRequestMerged" service="org.moqui.impl.GitReviewServices.merge#MergeRequest" when="post-service">
        <actions><service-call name="mantle.work.GitServices.handle#MergeRequestEvent" in-map="{mergeRequestId:mergeRequestId, action:'merged'}" ignore-error="true"/></actions>
    </seca>
    <seca id="GitMergeRequestReviewers" service="org.moqui.impl.GitReviewServices.set#MergeRequestReviewers" when="post-service">
        <actions><service-call name="mantle.work.GitServices.handle#MergeRequestEvent" in-map="{mergeRequestId:mergeRequestId, action:'review_requested'}" ignore-error="true"/></actions>
    </seca>
    <seca id="GitCommitStatusFailed" service="org.moqui.impl.GitServices.create#GitCommitStatus" when="post-service">
        <condition><expression>commitStatusId &amp;&amp; ['failure', 'error'].includes(state)</expression></condition>
        <actions><service-call name="mantle.work.GitServices.notify#CommitStatusFailed" in-map="{commitStatusId:commitStatusId}" ignore-error="true"/></actions>
    </seca>
</secas>
