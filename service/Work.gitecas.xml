<!-- Commits, branches and tags of the git repositories linked to projects, on tasks: the conventions are in the comment
    at the top of mantle/work/GitServices.xml. Each rule runs on pushes, mirror fetches, imports, and commits made through Moqui (writes). -->
<gitecas xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/git-eca-3.xsd">
    <giteca rule-name="LinkCommitTasks" source="push,fetch,import,write" event="commit">
        <actions><service-call name="mantle.work.GitServices.link#CommitReferences" in-map="context"/></actions>
    </giteca>
    <giteca rule-name="LinkTagWorkEfforts" source="push,fetch,import,write" event="tag">
        <actions><service-call name="mantle.work.GitServices.link#RefByName" in-map="context"/></actions>
    </giteca>
    <giteca rule-name="LinkBranchTask" source="push,fetch,import,write" event="ref-update" ref-type="branch">
        <condition><expression>changeType == 'create'</expression></condition>
        <actions><service-call name="mantle.work.GitServices.link#RefByName" in-map="context"/></actions>
    </giteca>
    <giteca rule-name="CloseRefLinks" source="push,fetch,import,write" event="ref-update">
        <condition><expression>changeType == 'delete'</expression></condition>
        <actions><service-call name="mantle.work.GitServices.close#RefLinks" in-map="context"/></actions>
    </giteca>
    <giteca rule-name="CompleteKeywordTasks" source="push,fetch,import,write" event="ref-update" default-branch-only="true">
        <condition><expression>newCommitIds.length &gt; 0</expression></condition>
        <actions><service-call name="mantle.work.GitServices.apply#CommitKeywords" in-map="context"/></actions>
    </giteca>
</gitecas>
