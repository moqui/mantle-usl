<entity-facade-xml type="seed-initial">
    <!-- Artifact group for all of the Mantle REST API via the mantle resource (the root resource) -->
    <artifactGroups artifactGroupId="MANTLE_API" description="Mantle REST API (via root resource)">
        <artifacts artifactTypeEnumId="AT_REST_PATH" artifactName="/mantle" inheritAuthz="Y"/>
        <authz artifactAuthzId="MANTLE_API_ADMIN" userGroupId="ADMIN" authzTypeEnumId="AUTHZT_ALWAYS" authzActionEnumId="AUTHZA_ALL"/>
    </artifactGroups>
    <!-- Not enabled by default, risky having read/write access to all mantle data, here as an example for testing:
    <moqui.security.ArtifactGroupMember artifactGroupId="MANTLE_API" artifactName="mantle\..*"
            nameIsPattern="Y" artifactTypeEnumId="AT_ENTITY" inheritAuthz="Y"/>
    -->
    <!-- The members of a project (active WorkEffortParty, through their UserAccount's party) may clone, fetch and push
        to the git repositories linked to it; force pushes and ref deletes take a grant of their own -->
    <moqui.security.ArtifactAuthz artifactAuthzId="GitRepositoriesProjectMember" userGroupId="ALL_USERS"
            artifactGroupId="GitRepositories" authzTypeEnumId="AUTHZT_ALLOW" authzActionEnumId="AUTHZA_ALL"
            authzServiceName="mantle.work.GitServices.check#GitRepositoryAuthz"/>
    <!-- Artifact group for all of the Mantle REST API via the mantle resource (the root resource) -->
    <artifactGroups artifactGroupId="MANTLE_MY_API" description="Mantle My Info REST API">
        <artifacts artifactTypeEnumId="AT_REST_PATH" artifactName="/mantle/my" inheritAuthz="Y"/>
        <authz artifactAuthzId="MANTLE_MY_API_ALL" userGroupId="ALL_USERS" authzTypeEnumId="AUTHZT_ALLOW" authzActionEnumId="AUTHZA_ALL"/>
    </artifactGroups>

    <!-- Special Permissions - NOTE: other such permissions that the data model seed data relies on are in MantleUdmSetupData.xml in mantle-udm -->
    <userPermissions userPermissionId="ORDER_APPROVE" description="Order Approve"/>
    <userGroupPermissions userGroupId="ADMIN" userPermissionId="ORDER_APPROVE" fromDate="0"/>
    <userPermissions userPermissionId="CARD_NUMBER_EDIT" description="Credit Card Number Edit"/>
    <userGroupPermissions userGroupId="ADMIN" userPermissionId="CARD_NUMBER_EDIT" fromDate="0"/>

    <userPermissions userPermissionId="FISCAL_REOPEN" description="Fiscal Period Reopen"/>
    <userGroupPermissions userGroupId="ADMIN" userPermissionId="FISCAL_REOPEN" fromDate="0"/>
    <userPermissions userPermissionId="GL_POST_CLOSED" description="GL Post to Closed Period"/>
    <userGroupPermissions userGroupId="ADMIN" userPermissionId="GL_POST_CLOSED" fromDate="0"/>

    <userPermissions userPermissionId="TIME_ENTRY_RATE" description="Time Entry Rate Override"/>
    <userGroupPermissions userGroupId="ADMIN" userPermissionId="TIME_ENTRY_RATE" fromDate="0"/>
    <!-- approving anyone's timesheet when the organization's timesheet policy says any (mantle.work.TimesheetServices) -->
    <userPermissions userPermissionId="TIMESHEET_APPROVE" description="Timesheet Approve (any person, by policy)"/>
    <userGroupPermissions userGroupId="ADMIN" userPermissionId="TIMESHEET_APPROVE" fromDate="0"/>
    <!-- approving, rejecting and changing allocations of people to projects, and staffing placeholders (mantle.work.ResourceServices) -->
    <userPermissions userPermissionId="ALLOCATION_APPROVE" description="Allocation Approve (people's time on projects)"/>
    <userGroupPermissions userGroupId="ADMIN" userPermissionId="ALLOCATION_APPROVE" fromDate="0"/>
    <!-- a milestone's gate decided for its approver (a client contact) by one who manages projects (mantle.work.ProjectServices
        approve#MilestoneApproval), the gates set and the estimate sent on the projects they see -->
    <userPermissions userPermissionId="MILESTONE_APPROVE" description="Milestone Approve (record a gate's decision for its approver)"/>
    <userGroupPermissions userGroupId="ADMIN" userPermissionId="MILESTONE_APPROVE" fromDate="0"/>
    <!-- a client contact who signs in (an app's client group holds it, IronStone's BOSS_PROJECT_CLIENT): the project services see
        for such a user only the shared part of the client projects of its organizations (mantle.work.ProjectServices
        get#ClientProjectInfo, get#VisibleProjectInfo; mantle.party.CommunicationServices get#RecordLinkInfo, get#RecordTimeline),
        whatever other group it is in. Not granted to ADMIN, nor to any group by default. The group that holds it should hold
        the framework's EXTERNAL_USER too (no record rooms, records drive, others' presence or agents), as IronStone's does. -->
    <userPermissions userPermissionId="PROJECT_CLIENT" description="Project Client (sees only the shared part of its organizations' projects)"/>
    <!-- the time logged on a work effort in its record timeline (Chatter; mantle.party.CommunicationServices.get#RecordTimeline) -->
    <moqui.service.ServiceRegister serviceRegisterId="TimeEntryTimeline" serviceTypeEnumId="RecordTimelineSource"
            description="Time logged on a work effort" serviceName="mantle.work.TimeServices.get#TimeEntryTimeline"/>

    <!-- deleting a directory party (mantle.party.ContactBookServices.delete#Contact); a personal contact's owner needs none -->
    <userPermissions userPermissionId="CONTACT_ADMIN" description="Contact Admin (delete directory contacts)"/>
    <userGroupPermissions userGroupId="ADMIN" userPermissionId="CONTACT_ADMIN" fromDate="0"/>

    <moqui.basic.Enumeration enumId="AllStoresMarkupLabelShipment" description="All Product Stores Markup Shipment Labels (set to 'true')" enumTypeId="UserPreferenceKey"/>
    <moqui.basic.Enumeration enumId="AllStoresMarkupLabelOrder" description="All Product Stores Markup Order Shipping (set to 'true')" enumTypeId="UserPreferenceKey"/>

    <!-- Configuration for Internal Financial Account Payment Processing -->
    <moqui.basic.Enumeration description="Financial Account" enumId="PgtFinancialAccount" enumTypeId="PaymentGatewayType"/>
    <mantle.account.method.PaymentGatewayConfig paymentGatewayConfigId="FinancialAccountLocal"
            paymentGatewayTypeEnumId="PgtFinancialAccount" description="Financial Account Local"
            authorizeServiceName="mantle.account.FinancialAccountServices.authorize#FinancialAccountPayment"
            captureServiceName="mantle.account.FinancialAccountServices.capture#FinancialAccountPayment"
            releaseServiceName="mantle.account.FinancialAccountServices.release#FinancialAccountPayment"
            refundServiceName="mantle.account.FinancialAccountServices.refund#FinancialAccountPayment"/>

    <moqui.service.ServiceRegister serviceRegisterId="OrderPayment50Split" serviceTypeEnumId="SettleTermOrderPmt"
            description="Settlement Term Order Payments - Half on Due Date, Half After Delivery"
            serviceName="mantle.order.OrderServices.create#OrderPayments50Split"/>
    <mantle.account.invoice.SettlementTerm settlementTermId="OrderPayment50Split30Days" termTypeEnumId="TtFinPaymentDays"
            description="Half Due In Advance, Half Due 30 Days after Invoice" termValue="30" termValueUomId="TF_day"
            orderPmtServiceRegisterId="OrderPayment50Split"/>

    <!-- ========== Global Preferences ========== -->

    <!-- User Group Preference for mantle content root, used in various services; these may be modified after install or for custom installs -->
    <moqui.security.UserGroupPreference userGroupId="ALL_USERS" preferenceKey="mantle.content.root"
            preferenceValue="dbresource://mantle/content"/>
    <moqui.security.UserGroupPreference userGroupId="ALL_USERS" preferenceKey="mantle.content.large.root"
            preferenceValue="dbresource://mantle/content"/>

    <moqui.resource.DbResource resourceId="MANTLE" filename="mantle" isFile="N"/>
    <moqui.resource.DbResource resourceId="MANTLE_CONTENT" filename="content" isFile="N" parentResourceId="MANTLE"/>
    <moqui.resource.DbResource resourceId="MCNT_ASSET" filename="asset" isFile="N" parentResourceId="MANTLE_CONTENT"/>
    <moqui.resource.DbResource resourceId="MCNT_FACILITY" filename="facility" isFile="N" parentResourceId="MANTLE_CONTENT"/>
    <moqui.resource.DbResource resourceId="MCNT_INVOICE" filename="invoice" isFile="N" parentResourceId="MANTLE_CONTENT"/>
    <moqui.resource.DbResource resourceId="MCNT_ORDER" filename="order" isFile="N" parentResourceId="MANTLE_CONTENT"/>
    <moqui.resource.DbResource resourceId="MCNT_PARTY" filename="party" isFile="N" parentResourceId="MANTLE_CONTENT"/>
    <moqui.resource.DbResource resourceId="MCNT_PAYMENT" filename="payment" isFile="N" parentResourceId="MANTLE_CONTENT"/>
    <moqui.resource.DbResource resourceId="MCNT_PAYMENT_METHOD" filename="paymentMethod" isFile="N" parentResourceId="MANTLE_CONTENT"/>
    <moqui.resource.DbResource resourceId="MCNT_PRODUCT" filename="product" isFile="N" parentResourceId="MANTLE_CONTENT"/>
    <moqui.resource.DbResource resourceId="MCNT_REQUEST" filename="request" isFile="N" parentResourceId="MANTLE_CONTENT"/>
    <moqui.resource.DbResource resourceId="MCNT_SHIPMENT" filename="shipment" isFile="N" parentResourceId="MANTLE_CONTENT"/>
    <moqui.resource.DbResource resourceId="MCNT_WORK" filename="work" isFile="N" parentResourceId="MANTLE_CONTENT"/>

    <!-- ========== Organization Based Entity Filters ========== -->

    <!-- User organization entity filters; see mantle.party.PartyServices.setup#UserOrganizationInfo -->
    <moqui.security.EntityFilterSet entityFilterSetId="MANTLE_USER_ORG" description="User Organization Filters">
        <filters entityFilterId="MANTLE_USER_ORG_1" entityName="mantle.account.invoice.Invoice" joinOr="Y"
                filterMap="({fromPartyId: filterOrgIds, toPartyId: filterOrgIds})"/>
        <filters entityFilterId="MANTLE_USER_ORG_2" entityName="mantle.account.payment.Payment" joinOr="Y"
                filterMap="({fromPartyId: filterOrgIds, toPartyId: filterOrgIds})"/>
        <filters entityFilterId="MANTLE_USER_ORG_3" entityName="mantle.order.OrderPart" joinOr="Y"
                filterMap="({vendorPartyId: filterOrgIds, customerPartyId: filterOrgIds})"/>
        <filters entityFilterId="MANTLE_USER_ORG_3R" entityName="mantle.order.return.ReturnHeader" joinOr="Y"
                filterMap="({vendorPartyId: filterOrgIds, customerPartyId: filterOrgIds})"/>
        <filters entityFilterId="MANTLE_USER_ORG_4" entityName="mantle.shipment.Shipment" joinOr="Y"
                filterMap="({fromPartyId: filterOrgIds, toPartyId: filterOrgIds})"/>
        <filters entityFilterId="MANTLE_USER_ORG_5" entityName="mantle.account.financial.FinancialAccount" filterMap="({organizationPartyId: filterOrgIds})"/>
        <filters entityFilterId="MANTLE_USER_ORG_6" entityName="mantle.ledger.transaction.AcctgTrans" filterMap="({organizationPartyId: filterOrgIds})"/>
        <filters entityFilterId="MANTLE_USER_ORG_7" entityName="mantle.party.time.TimePeriod" filterMap="({partyId: filterOrgIds})"/>
        <!-- PartyRelationship: toPartyId in filterOrgIds OR relationshipTypeEnumId != PrtEmployee -->
        <!-- don't include by default, adds overhead and only applicable to very specific HR or payroll use cases:
        <filters entityFilterId="MANTLE_USER_ORG_8" entityName="mantle.party.PartyRelationship"
                filterMap="({_join: 'or', _list: [{toPartyId: filterOrgIds, _comp: 'in'}, {relationshipTypeEnumId: (filterOrgIds ? 'PrtEmployee' : null), _comp: '!='}]})"/>
        -->
        <!-- Party filter allows _NA_ for user org, needed for general/shared parties like carriers, etc -->
        <filters entityFilterId="MANTLE_USER_ORG_9" entityName="mantle.party.Party" joinOr="Y"
                filterMap="({ownerPartyId: ['_NA_'].concat(filterOrgIds || [])})"/>
        <!-- Personal contacts: a party with privateOwnerUserId is seen only by that user. A second filter on Party, so it
            is ANDed with the one above; the or-list form because a null in an IN list is not IS NULL. The same condition
            is explicit in find#Party, search#Party, lookup#ById, the duplicate services and the party drop-downs. -->
        <filters entityFilterId="MANTLE_USER_ORG_9P" entityName="mantle.party.Party"
                filterMap="({_join: 'or', _list: [{privateOwnerUserId: null}, {privateOwnerUserId: ec.user.userId || null}]})"/>
        <!-- NOTE: Product, Category, and Feature user org filters do not include ownerPartyId '_NA_', if not associated can't see/use -->
        <filters entityFilterId="MANTLE_USER_ORG_A" entityName="mantle.product.Product" filterMap="({ownerPartyId: filterOrgIds})"/>
        <filters entityFilterId="MANTLE_USER_ORG_B" entityName="mantle.product.category.ProductCategory" filterMap="({ownerPartyId: filterOrgIds})"/>
        <filters entityFilterId="MANTLE_USER_ORG_C" entityName="mantle.product.feature.ProductFeature" filterMap="({ownerPartyId: filterOrgIds})"/>
        <filters entityFilterId="MANTLE_USER_ORG_D" entityName="mantle.product.store.ProductStore" filterMap="({organizationPartyId: filterOrgIds})"/>
        <filters entityFilterId="MANTLE_USER_ORG_F" entityName="mantle.facility.Facility" filterMap="({ownerPartyId: filterOrgIds})"/>
    </moqui.security.EntityFilterSet>
    <moqui.security.EntityFilterSet entityFilterSetId="MANTLE_ACTIVE_ORG" description="Active Organization Filters" applyCond="activeOrgId" allowMissingAlias="Y">
        <filters entityFilterId="MANTLE_ACTIVE_ORG_1" entityName="mantle.account.invoice.Invoice" joinOr="Y"
                filterMap="({fromPartyId: activeOrgId, toPartyId: activeOrgId})"/>
        <filters entityFilterId="MANTLE_ACTIVE_ORG_2" entityName="mantle.account.payment.Payment" joinOr="Y"
                filterMap="({fromPartyId: activeOrgId, toPartyId: activeOrgId})"/>
        <filters entityFilterId="MANTLE_ACTIVE_ORG_3" entityName="mantle.order.OrderPart" joinOr="Y"
                filterMap="({vendorPartyId: activeOrgId, customerPartyId: activeOrgId})"/>
        <filters entityFilterId="MANTLE_ACTIVE_ORG_3R" entityName="mantle.order.return.ReturnHeader" joinOr="Y"
                filterMap="({vendorPartyId: activeOrgId, customerPartyId: activeOrgId})"/>
        <filters entityFilterId="MANTLE_ACTIVE_ORG_4" entityName="mantle.shipment.Shipment" joinOr="Y"
                filterMap="({fromPartyId: activeOrgId, toPartyId: activeOrgId})"/>
        <filters entityFilterId="MANTLE_ACTIVE_ORG_5" entityName="mantle.account.financial.FinancialAccount" filterMap="({organizationPartyId: activeOrgId})"/>
        <filters entityFilterId="MANTLE_ACTIVE_ORG_6" entityName="mantle.ledger.transaction.AcctgTrans" filterMap="({organizationPartyId: activeOrgId})"/>
        <filters entityFilterId="MANTLE_ACTIVE_ORG_7" entityName="mantle.party.time.TimePeriod"
                filterMap="({_join: 'or', _list: [{partyId: activeOrgId}, {timePeriodTypeId: (activeOrgId ? 'Sales%' : null), _comp: 'like'}]})"/>
        <!-- PartyRelationship: toPartyId == activeOrgId OR relationshipTypeEnumId != PrtEmployee -->
        <!-- don't include by default, adds overhead and only applicable to very specific HR or payroll use cases:
        <filters entityFilterId="MANTLE_ACTIVE_ORG_8" entityName="mantle.party.PartyRelationship"
                filterMap="({_join: 'or', _list: [{toPartyId: activeOrgId}, {relationshipTypeEnumId: (activeOrgId ? 'PrtEmployee' : null), _comp: '!='}]})"/>
        -->
        <!-- Space before '[' and parentheses: Groovy parses '?[' as the safe-index operator, not a ternary. -->
        <filters entityFilterId="MANTLE_ACTIVE_ORG_9" entityName="mantle.party.Party" joinOr="Y"
                filterMap="({ownerPartyId: (activeOrgId ? [activeOrgId, '_NA_'] : null)})"/>
        <!-- Personal contacts, as MANTLE_USER_ORG_9P -->
        <filters entityFilterId="MANTLE_ACTIVE_ORG_9P" entityName="mantle.party.Party"
                filterMap="({_join: 'or', _list: [{privateOwnerUserId: null}, {privateOwnerUserId: ec.user.userId || null}]})"/>
        <filters entityFilterId="MANTLE_ACTIVE_ORG_A" entityName="mantle.product.Product"
                filterMap="({ownerPartyId: (activeOrgId ? [activeOrgId, '_NA_'] : null)})"/>
        <filters entityFilterId="MANTLE_ACTIVE_ORG_B" entityName="mantle.product.category.ProductCategory"
                filterMap="({ownerPartyId: (activeOrgId ? [activeOrgId, '_NA_'] : null)})"/>
        <filters entityFilterId="MANTLE_ACTIVE_ORG_C" entityName="mantle.product.feature.ProductFeature"
                filterMap="({ownerPartyId: (activeOrgId ? [activeOrgId, '_NA_'] : null)})"/>
        <filters entityFilterId="MANTLE_ACTIVE_ORG_D" entityName="mantle.product.store.ProductStore"
                filterMap="({organizationPartyId: (activeOrgId ? [activeOrgId, '_NA_'] : null)})"/>
        <!-- allow these for 3rd party facilities regardless of active org:
        <filters entityFilterId="MANTLE_ACTIVE_ORG_F" entityName="mantle.facility.Facility"
                filterMap="({ownerPartyId: (activeOrgId ? [activeOrgId, '_NA_'] : null)})"/> -->
    </moqui.security.EntityFilterSet>
    <!-- Personal contacts on their own, for an app whose authz has the active organization filter: that set applies only
        while an organization is active, and a personal contact must stay hidden from other users without one too. The
        IronStone apps' authz records carry this set beside MANTLE_ACTIVE_ORG. -->
    <moqui.security.EntityFilterSet entityFilterSetId="MANTLE_PRIVATE_CONTACT" description="Personal Contact Filter" allowMissingAlias="Y">
        <filters entityFilterId="MANTLE_PRIVATE_CONTACT_1" entityName="mantle.party.Party"
                filterMap="({_join: 'or', _list: [{privateOwnerUserId: null}, {privateOwnerUserId: ec.user.userId || null}]})"/>
    </moqui.security.EntityFilterSet>

    <!-- ========== Notifications - Business Event ========== -->

    <!-- Notification: High Priority Order -->
    <moqui.security.user.NotificationTopic topic="OrderHighPriority" description="Order - High Priority" typeString="danger"
            showAlert="Y" alertNoAutoHide="Y" persistOnSend="Y" receiveNotifications="Y" isPrivate="Y" emailTemplateId="NOTIFICATION"
            titleTemplate="High Priority Order ${orderId}:${orderPartSeqId} - Priority ${priority}"
            linkTemplate="/vapps/PopcAdmin/Order/OrderDetail?orderId=${orderId}"/>

    <!-- Notification: a user mentioned in a note or message on a record, and the followers of a record (Chatter;
        mantle.party.CommunicationServices.notify#RecordMention and notify#RecordFollowers). No link template: the
        record's screen belongs to the app, so the caller passes it as recordUrl. -->
    <moqui.security.user.NotificationTopic topic="ChatterMention" description="Mentioned on a Record" typeString="info"
            showAlert="Y" persistOnSend="Y" receiveNotifications="Y" isPrivate="Y" emailTemplateId="NOTIFICATION"
            titleTemplate="${authorName} mentioned you on ${recordName}: ${summary}" linkTemplate=""/>
    <moqui.security.user.NotificationTopic topic="RecordFollow" inboxEnumId="NinUpdates" description="Activity on a Followed Record" typeString="info"
            showAlert="N" persistOnSend="Y" receiveNotifications="Y" isPrivate="Y" emailTemplateId="NOTIFICATION"
            titleTemplate="${authorName} on ${recordName}: ${summary}" linkTemplate=""/>

    <!-- Notification: the other topics of the IronStone shell. No link templates: the app passes the link. Each title names
        the message fields its sender puts in the message map, besides recordEntityName and recordId when it is on a
        record. A topic that waits on a decision (an approval) is an app's, with the framework's approveServiceName and
        refuseServiceName on its NotificationTopic; those services get recordEntityName, recordId, the message's
        messageJson map and, for a refuse, reason. -->
    <!-- a mention in a chat room, as org.moqui.impl.ChatServices send#Message and edit#Message send it: roomName, chatRoomId,
        eventSeq, authorUserId, authorName and summary in the message, reason NrMention, the room (moqui.chat.ChatRoom) as
        its record, the actor the author, and the caller's roomUrl as its link; in the Notifications inbox (it asks for the
        user, so it is in the badge) -->
    <moqui.security.user.NotificationTopic topic="ChatMention" inboxEnumId="NinNotifications" description="Mentioned in a Chat Room" typeString="info"
            showAlert="Y" persistOnSend="Y" receiveNotifications="Y" isPrivate="Y" emailTemplateId="NOTIFICATION"
            titleTemplate="${authorName} mentioned you in ${roomName}: ${summary}" linkTemplate=""/>
    <!-- a task, activity or event coming due or starting: workEffortId, workEffortName, whenText (the due or start time in
        the user's words, such as "due today" or "at 2:30 PM") -->
    <moqui.security.user.NotificationTopic topic="WorkEffortReminder" description="Task or Event Reminder" typeString="info"
            showAlert="Y" alertNoAutoHide="Y" persistOnSend="Y" receiveNotifications="Y" isPrivate="Y" emailTemplateId="NOTIFICATION"
            titleTemplate="Reminder: ${workEffortName}, ${whenText}" linkTemplate=""/>
    <!-- a work item of a project assigned to the user by someone else (mantle.work.TaskServices.notify#TaskAssigned):
        workEffortId, workEffortName, rootWorkEffortId, projectName, assignedByName, the task as the record; in the
        Notifications inbox. The app that shows work items sets the link (IronStone Projects: BossSetupData.xml). -->
    <moqui.security.user.NotificationTopic topic="WorkItemAssigned" inboxEnumId="NinNotifications" description="Work Item Assigned to You" typeString="info"
            showAlert="Y" persistOnSend="Y" receiveNotifications="Y" isPrivate="Y" emailTemplateId="NOTIFICATION"
            titleTemplate="${assignedByName} assigned you ${workEffortId}: ${workEffortName} (${projectName})"/>
    <!-- a status update posted on a project the user is on (mantle.work.ProjectServices.post#ProjectUpdate): workEffortId,
        workEffortName, healthEnumId, healthLabel, percentComplete, subject, authorName, communicationEventId, the project as
        the record; in the Updates inbox. The app that shows projects sets the link (IronStone Projects: BossSetupData.xml). -->
    <moqui.security.user.NotificationTopic topic="ProjectStatusUpdate" inboxEnumId="NinUpdates" description="Project Status Update" typeString="info"
            showAlert="N" persistOnSend="Y" receiveNotifications="Y" isPrivate="Y" emailTemplateId="NOTIFICATION"
            titleTemplate="${workEffortName} is ${healthLabel}: ${subject} (${authorName})"/>
    <!-- a new request to triage (mantle.request.RequestServices.notify#RequestTriage, from the Request rule of
        entity/Request.eecas.xml: a request submitted, or given a project): requestId, requestName, typeLabel, rootWorkEffortId,
        projectName and projectSuffix (" (name)", both empty for one with no project), channelLabel (app, email, form), fromName,
        the request as the record; to the
        project's triage assignee, else its managers (for one with no project the organization's triage assignee); in the
        Notifications inbox. The app that triages requests sets the link (IronStone Projects: BossSetupData.xml). -->
    <moqui.security.user.NotificationTopic topic="RequestTriage" inboxEnumId="NinNotifications" description="New Request to Triage" typeString="info"
            showAlert="Y" persistOnSend="Y" receiveNotifications="Y" isPrivate="Y" emailTemplateId="NOTIFICATION"
            titleTemplate="New request ${requestId}: ${requestName}${projectSuffix}"/>
    <!-- a request's status moved by its work (mantle.request.RequestServices.complete#RequestFromWork): requestId, requestName,
        statusId, statusLabel, workEffortId (the item that moved it), the request as the record; to its followers and its
        reporter's and assignee's users; in the Updates inbox -->
    <moqui.security.user.NotificationTopic topic="RequestUpdate" inboxEnumId="NinUpdates" description="Request Update" typeString="info"
            showAlert="N" persistOnSend="Y" receiveNotifications="Y" isPrivate="Y" emailTemplateId="NOTIFICATION"
            titleTemplate="Request ${requestId} ${statusLabel}: ${requestName}"/>
    <!-- weekly timesheets (mantle.work.TimesheetServices): timesheetId, partyId, personName, weekText, weekStart, hoursText, change,
        actorName and reason, the timesheet as the record. A submitted week asks its approvers for a decision (TimesheetApproval, whose
        approve and refuse services approve or return it; a return needs a reason); the person hears of a return or reopen
        (TimesheetReturned) and of the approval (TimesheetApproved, Updates); TimesheetMissing reminds a person of a week not
        submitted (weekText, hoursText, expectedText; send#MissingTimeReminders). The app that shows timesheets sets the links
        (IronStone Projects: BossSetupData.xml). -->
    <moqui.security.user.NotificationTopic topic="TimesheetApproval" inboxEnumId="NinNotifications" description="Timesheet to Approve" typeString="info"
            showAlert="Y" persistOnSend="Y" receiveNotifications="Y" isPrivate="Y" emailTemplateId="NOTIFICATION"
            approveServiceName="mantle.work.TimesheetServices.approve#TimesheetNotice" refuseServiceName="mantle.work.TimesheetServices.return#TimesheetNotice"
            refuseReasonRequired="Y" titleTemplate="Approve ${personName}'s week of ${weekText}: ${hoursText} h"/>
    <moqui.security.user.NotificationTopic topic="TimesheetReturned" inboxEnumId="NinNotifications" description="Timesheet Returned" typeString="warning"
            showAlert="Y" persistOnSend="Y" receiveNotifications="Y" isPrivate="Y" emailTemplateId="NOTIFICATION"
            titleTemplate="Your week of ${weekText} was ${change} by ${actorName}: ${reason}"/>
    <moqui.security.user.NotificationTopic topic="TimesheetApproved" inboxEnumId="NinUpdates" description="Timesheet Approved" typeString="success"
            showAlert="N" persistOnSend="Y" receiveNotifications="Y" isPrivate="Y" emailTemplateId="NOTIFICATION"
            titleTemplate="Your week of ${weekText} was approved by ${actorName} (${hoursText} h)"/>
    <moqui.security.user.NotificationTopic topic="TimesheetMissing" inboxEnumId="NinNotifications" description="Missing Time Reminder" typeString="warning"
            showAlert="Y" persistOnSend="Y" receiveNotifications="Y" isPrivate="Y" emailTemplateId="NOTIFICATION"
            titleTemplate="Your week of ${weekText} is not submitted: ${hoursText} of ${expectedText} h"/>
    <!-- allocations of people to projects (mantle.work.ResourceServices): workEffortAllocationId, rootWorkEffortId, projectName,
        whoText (the person, or the role of a placeholder), hoursText, periodText, requesterName, actorName, decision and reasonSuffix (": " and the reason, or empty), the
        allocation as the record. A request asks the approvers (the holders of ALLOCATION_APPROVE) for a decision (AllocationRequest,
        whose approve and refuse services approve or reject it; a rejection needs a reason); its requester and the person hear the
        decision (AllocationDecision, Updates). The app that shows allocations sets the links (IronStone Projects: BossSetupData.xml). -->
    <moqui.security.user.NotificationTopic topic="AllocationRequest" inboxEnumId="NinNotifications" description="Allocation to Approve" typeString="info"
            showAlert="Y" persistOnSend="Y" receiveNotifications="Y" isPrivate="Y" emailTemplateId="NOTIFICATION"
            approveServiceName="mantle.work.ResourceServices.approve#AllocationNotice" refuseServiceName="mantle.work.ResourceServices.reject#AllocationNotice"
            refuseReasonRequired="Y" titleTemplate="Approve ${whoText} on ${projectName}: ${hoursText} a week, ${periodText}"/>
    <moqui.security.user.NotificationTopic topic="AllocationDecision" inboxEnumId="NinUpdates" description="Allocation Decided" typeString="info"
            showAlert="N" persistOnSend="Y" receiveNotifications="Y" isPrivate="Y" emailTemplateId="NOTIFICATION"
            titleTemplate="${whoText} on ${projectName} ${decision} by ${actorName}${reasonSuffix}"/>
    <!-- a milestone's gate (mantle.work.ProjectServices request#, approve#, refuse#MilestoneApproval): workEffortApprovalId, workEffortId,
        milestoneName, rootWorkEffortId, projectName, approverName, requesterName, actorName, decision and reasonSuffix, the request
        (WorkEffortApproval) as the record. A request asks the approver's users for a decision (MilestoneApproval, whose approve and refuse
        services decide it; a refusal needs a reason); the one who asked hears the decision (MilestoneDecision, Updates). The app that
        shows milestones sets the links (IronStone Projects: BossSetupData.xml). -->
    <moqui.security.user.NotificationTopic topic="MilestoneApproval" inboxEnumId="NinNotifications" description="Milestone to Approve" typeString="info"
            showAlert="Y" persistOnSend="Y" receiveNotifications="Y" isPrivate="Y" emailTemplateId="NOTIFICATION"
            approveServiceName="mantle.work.ProjectServices.approve#MilestoneApprovalNotice" refuseServiceName="mantle.work.ProjectServices.refuse#MilestoneApprovalNotice"
            refuseReasonRequired="Y" titleTemplate="Approve ${milestoneName} of ${projectName}"/>
    <moqui.security.user.NotificationTopic topic="MilestoneDecision" inboxEnumId="NinUpdates" description="Milestone Approval Decided" typeString="info"
            showAlert="N" persistOnSend="Y" receiveNotifications="Y" isPrivate="Y" emailTemplateId="NOTIFICATION"
            titleTemplate="${milestoneName} of ${projectName} ${decision} by ${actorName}${reasonSuffix}"/>
    <!-- the actions of the mail client's rules that make requests and work items (org.moqui.impl.EmailClientServices
        run#EmailRules runs the service in optionValue for the action in enumCode; impl-projects.md F6) -->
    <moqui.basic.Enumeration enumId="ErActCreateRequest" enumTypeId="EmailRuleAction" enumCode="createRequest" sequenceNum="1"
            description="Make a request" optionValue="mantle.request.RequestServices.create#RequestFromEmail"/>
    <moqui.basic.Enumeration enumId="ErActCreateWorkItem" enumTypeId="EmailRuleAction" enumCode="createWorkItem" sequenceNum="2"
            description="Make a work item (a request for outside senders)" optionValue="mantle.request.RequestServices.create#WorkItemFromEmail"/>
    <!-- a release's notes published (mantle.work.ProjectServices.publish#ReleaseNotes) to the followers of the release and of its
        project: workEffortId, version, rootWorkEffortId, projectName, actorName, dateText, wikiPageId (the published page), the
        release as the record; in the Updates inbox. The app that shows releases sets the link (IronStone Projects:
        BossSetupData.xml). -->
    <moqui.security.user.NotificationTopic topic="ReleasePublished" inboxEnumId="NinUpdates" description="Release Notes Published" typeString="info"
            showAlert="N" persistOnSend="Y" receiveNotifications="Y" isPrivate="Y" emailTemplateId="NOTIFICATION"
            titleTemplate="${projectName} ${version} released: the notes (${actorName})"/>
    <!-- merge requests and commit checks (mantle.work.GitServices.notify#MergeRequest and notify#CommitStatusFailed, by the
        rules of service/WorkGit.secas.xml): mergeRequestId, mergeRequestNum, title, repositoryId, sourceRef, targetRef,
        actorName and change, the merge request as the record; a check: repositoryId, commitId, shortId, summary, checkContext,
        state, stateLabel, description, targetUrl. Review requests and failed checks in the Notifications inbox, the other
        changes in Updates. The app that shows code sets the links (IronStone Projects: BossSetupData.xml). -->
    <moqui.security.user.NotificationTopic topic="MergeRequestReview" inboxEnumId="NinNotifications" description="Merge Request Review Requested" typeString="info"
            showAlert="Y" persistOnSend="Y" receiveNotifications="Y" isPrivate="Y" emailTemplateId="NOTIFICATION"
            titleTemplate="${actorName} asks for your review of !${mergeRequestNum} ${title} (${repositoryId})"/>
    <moqui.security.user.NotificationTopic topic="MergeRequestUpdate" inboxEnumId="NinUpdates" description="Merge Request Update" typeString="info"
            showAlert="N" persistOnSend="Y" receiveNotifications="Y" isPrivate="Y" emailTemplateId="NOTIFICATION"
            titleTemplate="!${mergeRequestNum} ${title}: ${actorName} ${change} (${repositoryId})"/>
    <moqui.security.user.NotificationTopic topic="CommitStatusFailed" inboxEnumId="NinNotifications" description="Commit Check Failed" typeString="warning"
            showAlert="Y" persistOnSend="Y" receiveNotifications="Y" isPrivate="Y" emailTemplateId="NOTIFICATION"
            titleTemplate="${checkContext} ${stateLabel} on ${shortId} of ${repositoryId}: ${summary}"/>
    <!-- a page to review and the decision on it: the framework seeds both topics (moqui.resource.wiki.WikiPageReview in
        framework/entity/ResourceEntities.xml), with the approval services of WikiPageReview (approveServiceName,
        refuseServiceName, refuseReasonRequired) and the message fields (wikiPageReviewId, wikiPageId, wikiSpaceId, pagePath,
        pageName, versionName, authorName, note, dueDate; for the decision reviewerName, decision, decisionText, decisionNote).
        Mantle sets only the email template, so the framework's row wins whichever file loads first (a data load updates
        only the fields an element has). -->
    <moqui.security.user.NotificationTopic topic="WikiPageReview" emailTemplateId="NOTIFICATION"/>
    <moqui.security.user.NotificationTopic topic="WikiPageReviewDecision" emailTemplateId="NOTIFICATION"/>
    <!-- a file or folder shared with the user: fileName, location, authorUserId, authorName -->
    <moqui.security.user.NotificationTopic topic="FileShare" description="File Shared with You" typeString="info"
            showAlert="Y" persistOnSend="Y" receiveNotifications="Y" isPrivate="Y" emailTemplateId="NOTIFICATION"
            titleTemplate="${authorName} shared ${fileName} with you" linkTemplate=""/>
    <!-- new mail in the Inbox (mail, internal messages and the mailbox posts delivered to the Inbox): fromName, subject,
        communicationEventId or emailMessageId. An alert only: the Inbox count and the Inbox keep it, not the notification
        list. -->
    <moqui.security.user.NotificationTopic topic="NewMail" description="New Mail" typeString="info"
            showAlert="Y" persistOnSend="N" receiveNotifications="Y" isPrivate="Y"
            titleTemplate="${fromName}: ${subject}" linkTemplate=""/>

    <!-- an event invitation, new or updated (mantle.work.EventServices.send#EventInvitations): workEffortId, workEffortName,
        organizerName, whenText (the time in the organizer's words), whereText, update (true for a changed event), cancelled,
        removed (true for an attendee taken off the event, remove#EventAttendee), message -->
    <moqui.security.user.NotificationTopic topic="EventInvitation" description="Event Invitation" typeString="info"
            showAlert="Y" persistOnSend="Y" receiveNotifications="Y" isPrivate="Y" emailTemplateId="NOTIFICATION"
            titleTemplate="${removed ? organizerName + ' removed you from ' + workEffortName : (cancelled ? organizerName + ' cancelled ' + workEffortName : (update ? organizerName + ' updated ' + workEffortName : organizerName + ' invited you to ' + workEffortName))}, ${whenText}"
            linkTemplate=""/>
    <!-- an attendee's answer to the organizer (mantle.work.EventServices.respond#EventInvitation): workEffortId, workEffortName,
        responderName, response (accept, tentative or decline), responseText (accepted, tentatively accepted, declined), message -->
    <moqui.security.user.NotificationTopic topic="EventInvitationResponse" inboxEnumId="NinUpdates" description="Answer to an Event Invitation" typeString="info"
            showAlert="Y" persistOnSend="Y" receiveNotifications="Y" isPrivate="Y" emailTemplateId="NOTIFICATION"
            titleTemplate="${responderName} ${responseText} ${workEffortName}${message ? ': ' + message : ''}" linkTemplate=""/>

    <!-- Email: invitations to attendees outside (no user account), iMIP replies and reminders by email. The services pass
        subject, fromAddress and fromName in bodyParameters, and the body. -->
    <moqui.basic.email.EmailTemplate emailTemplateId="MANTLE_CALENDAR_EMAIL" description="Calendar Invitation or Reminder" emailServerId="SYSTEM"
            fromAddress="${fromAddress}" fromName="${fromName}" ccAddresses="" bccAddresses="" subject="${subject}" sendPartial="Y"/>
    <!-- Email: the confirmation an unsubscribe waits for on a list that requires it (mantle.party.ConsentServices
        send#UnsubscribeVerifyEmail, when the list's Unsubscribe Verify email names no template): from the list's
        verifyEmailFrom, with the link of the page. -->
    <moqui.basic.email.EmailTemplate emailTemplateId="MANTLE_UNSUBSCRIBE_VERIFY" description="Unsubscribe Confirmation" emailServerId="SYSTEM"
            fromAddress="${fromAddress}" fromName="${fromName}" ccAddresses="" bccAddresses="" subject="${subject}"/>
    <!-- Email to a project's client contacts (mantle.work.ProjectServices): a status update posted for the client
        (send#ProjectUpdateEmail) and the estimate sent for the client's approval (send#EstimateEmail). From the project's
        organization's address; the services pass subject, fromAddress and fromName in bodyParameters, and the body. -->
    <moqui.basic.email.EmailTemplate emailTemplateId="MANTLE_PROJECT_UPDATE" description="Project Status Update to the Client" emailServerId="SYSTEM"
            fromAddress="${fromAddress}" fromName="${fromName}" ccAddresses="" bccAddresses="" subject="${subject}" sendPartial="Y"/>
    <moqui.basic.email.EmailTemplate emailTemplateId="MANTLE_PROJECT_ESTIMATE" description="Project Estimate for the Client's Approval" emailServerId="SYSTEM"
            fromAddress="${fromAddress}" fromName="${fromName}" ccAddresses="" bccAddresses="" subject="${subject}" sendPartial="Y"/>

    <!-- ========== Registered Services ========== -->

    <!-- Registered Services: Store Promotion -->
    <moqui.service.ServiceRegister serviceRegisterId="NewCustomerDiscount" serviceTypeEnumId="ProductStorePromotion"
            description="New Customer Discount" serviceName="mantle.product.PromotionServices.apply#NewCustomerDiscount"/>
    <moqui.service.ServiceRegister serviceRegisterId="BuyGetDiscount" serviceTypeEnumId="ProductStorePromotion"
            description="Buy X Get Y at Z% Discount" serviceName="mantle.product.PromotionServices.apply#BuyGetDiscount"/>
    <moqui.service.ServiceRegister serviceRegisterId="FlatDiscount" serviceTypeEnumId="ProductStorePromotion"
            description="Flat Discount per Quantity" serviceName="mantle.product.PromotionServices.apply#FlatDiscount"/>

    <!-- Registered Services: Store Order Pre-Approve Validation -->
    <moqui.service.ServiceRegister serviceRegisterId="OrderManualApprove" serviceTypeEnumId="OrderValidate"
            description="Require Manual Approval" serviceName="mantle.order.OrderInfoServices.validate#OrderRequireManual"/>

    <!-- ========== Service Jobs ========== -->

    <!-- Service Job: Auto-approve Orders Delayed - every 15 minutes by default -->
    <moqui.service.job.ServiceJob jobName="autoApprove_OrdersDelayed" description="Auto-approve Orders Delayed"
            serviceName="mantle.order.OrderServices.autoApprove#OrdersDelayed" cronExpression="0 0/15 * * * ?" paused="N"
            transactionTimeout="1800"/>
    <!-- Service Job: Create Recurring Orders - every night at 2:00 am -->
    <moqui.service.job.ServiceJob jobName="create_RecurringOrders" description="Create Recurring Orders"
            serviceName="mantle.order.OrderServices.create#RecurringOrders" cronExpression="0 0 2 * * ?" paused="N"
            transactionTimeout="1800"/>

    <!-- Service Job: Recalculate GL Account Org Summaries - once per hour by default -->
    <moqui.service.job.ServiceJob jobName="recalculate_GlAccountOrgSummaries" description="Recalculate GL Account Org Summaries"
            serviceName="mantle.ledger.LedgerServices.recalculate#GlAccountOrgSummaries" cronExpression="0 0 * * * ?" paused="N"
            transactionTimeout="1800"/>

    <!-- Service Job: Poll Payment Gateway Details (paused by default; cron for every night at 2:00 am) -->
    <moqui.service.job.ServiceJob jobName="poll_PaymentGatewayDetails" description="Poll Payment Gateway Details"
            serviceName="mantle.account.PaymentServices.poll#PaymentGatewayDetails" cronExpression="0 0 2 * * ?" paused="Y"
            transactionTimeout="1800"/>

    <!-- Service Job: Send Sales Invoice Past Due Emails (paused by default; cron for every Monday at 2:00 am) -->
    <moqui.service.job.ServiceJob jobName="send_SalesInvoicePastDueEmails" description="Send Sales Invoice Past Due Emails"
            serviceName="mantle.account.InvoiceServices.send#SalesInvoicePastDueEmails" cronExpression="0 0 2 ? * MON" paused="Y"
            transactionTimeout="3600">
        <parameters parameterName="daysPastDue" parameterValue="7"/>
        <parameters parameterName="daysPastInvoice" parameterValue="40"/>
        <parameters parameterName="daysLastEmail" parameterValue="2"/>
        <parameters parameterName="alsoPrimaryEmails" parameterValue="false"/>
        <!-- <parameters parameterName="organizationPartyIdList" parameterValue=""/> -->
    </moqui.service.job.ServiceJob>

    <!-- Service Job: Payroll Processing -->
    <moqui.security.user.NotificationTopic topic="ProcessTimePeriodPay" inboxEnumId="NinUpdates" description="Payroll Period Process Pay Completed"
            typeString="success" showAlert="Y" persistOnSend="Y" receiveNotifications="Y"
            titleTemplate="Process Pay Completed for Payroll Period ${parameters.timePeriodId} for pay date ${ec.l10n.format(results.payDate, '')}, total pay ${ec.l10n.format(results.totalPayAmount, '0.00')}"
            errorTitleTemplate="Error in Process Pay for Payroll Period ${parameters.timePeriodId}: ${serviceCallRun.errors}"
            linkTemplate=""/>
    <moqui.service.job.ServiceJob jobName="ProcessTimePeriodPay" description="Process Pay for Payroll Period"
            serviceName="mantle.humanres.PayrollServices.process#TimePeriodPay" topic="ProcessTimePeriodPay"/>

    <!-- Service Job: Send Due Reminders of tasks and events - every minute -->
    <moqui.service.job.ServiceJob jobName="send_DueReminders" description="Send Due Task and Event Reminders"
            serviceName="mantle.work.EventServices.send#DueReminders" cronExpression="0 0/1 * * * ?" paused="N"
            transactionTimeout="300"/>
    <!-- Service Job: Send Missing Time Reminders - every hour; each organization's timesheet policy says on which day and hour its people
        are reminded of last week's timesheet (mantle.work.TimesheetServices.send#MissingTimeReminders), once a week each -->
    <moqui.service.job.ServiceJob jobName="send_MissingTimeReminders" description="Send Missing Time Reminders"
            serviceName="mantle.work.TimesheetServices.send#MissingTimeReminders" cronExpression="0 0 * * * ?" paused="N"
            transactionTimeout="600"/>
    <!-- Service Job: Fetch Calendar Subscriptions that are due (each its own refresh interval) - every 15 minutes; nothing is
        fetched until the framework's ICalendar tool exists -->
    <moqui.service.job.ServiceJob jobName="fetch_CalendarSubscriptions" description="Fetch Calendar Subscriptions"
            serviceName="mantle.work.CalendarServices.fetch#CalendarSubscriptions" cronExpression="0 0/15 * * * ?" paused="N"
            transactionTimeout="1800"/>

    <!-- Service Job: Check All Parties for Duplicates (paused by default; cron for every night at 2:00 am) -->
    <moqui.service.job.ServiceJob jobName="check_AllPartyDuplicates" description="Check All Parties for Duplicates"
            serviceName="mantle.party.DuplicateServices.check#AllPartyDuplicates" cronExpression="0 0 2 * * ?" paused="Y"
            transactionTimeout="3600"/>

    <!-- The CalDAV and CardDAV adapters (MoquiConf.xml dav-server), called as a user who logged in with an app password;
        each checks the calendar's or the contact book's access itself, as the screens do. -->
    <moqui.security.ArtifactGroup artifactGroupId="MantleDavServices" description="CalDAV and CardDAV adapters"/>
    <moqui.security.ArtifactGroupMember artifactGroupId="MantleDavServices" artifactTypeEnumId="AT_SERVICE" inheritAuthz="Y" nameIsPattern="Y"
            artifactName="mantle\.(work\.CalendarDavServices|party\.ContactDavServices)\.(get#DavCollections|get#DavObjects|put#DavObject|delete#DavObject)"/>
    <moqui.security.ArtifactAuthz artifactAuthzId="MantleDavServicesALL" userGroupId="ALL_USERS" artifactGroupId="MantleDavServices"
            authzTypeEnumId="AUTHZT_ALWAYS" authzActionEnumId="AUTHZA_ALL"/>
</entity-facade-xml>
